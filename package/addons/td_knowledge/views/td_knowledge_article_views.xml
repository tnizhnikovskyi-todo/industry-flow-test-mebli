<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_knowledge_article_view_list" model="ir.ui.view">
        <field name="name">td.knowledge.article.list</field>
        <field name="model">td.knowledge.article</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="icon" string=" "/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="model_ids" widget="many2many_tags"/>
                <field name="group_ids" widget="many2many_tags" optional="hide"/>
                <field name="is_package" optional="show"/>
                <field name="write_date" string="Updated" optional="show"/>
            </list>
        </field>
    </record>

    <record id="td_knowledge_article_view_form" model="ir.ui.view">
        <field name="name">td.knowledge.article.form</field>
        <field name="model">td.knowledge.article</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title d-flex gap-2 align-items-center">
                        <field name="icon" class="td_knowledge_icon_input" placeholder="📘"/>
                        <h1 class="flex-grow-1"><field name="name" placeholder="Title of the article"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" placeholder="Top level"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_package" invisible="not is_package"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="body" class="td_knowledge_body" placeholder="Write the article: steps, screenshots, tables..."/>
                        </page>
                        <page string="Where to show" name="where">
                            <group>
                                <field name="model_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="menu_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="td_knowledge_article_view_search" model="ir.ui.view">
        <field name="name">td.knowledge.article.search</field>
        <field name="model">td.knowledge.article</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('body', 'ilike', self)]"/>
                <field name="parent_id"/>
                <field name="model_ids"/>
                <filter name="package" string="From the package" domain="[('is_package', '=', True)]"/>
                <filter name="own" string="Written here" domain="[('is_package', '=', False)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_parent" string="Section" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_td_knowledge_article" model="ir.actions.act_window">
        <field name="name">All articles</field>
        <field name="res_model">td.knowledge.article</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Write the first article</p>
            <p>Articles can be linked to screens: then the «Help» icon in the top bar shows them there.</p>
        </field>
    </record>

    <record id="action_td_knowledge_reader" model="ir.actions.client">
        <field name="name">Knowledge Base</field>
        <field name="tag">td_knowledge.reader</field>
        <field name="path">td-knowledge</field>
    </record>

    <menuitem id="menu_td_knowledge_root" name="Knowledge Base" web_icon="td_knowledge,static/description/icon.png"
              sequence="80" action="action_td_knowledge_reader"/>
    <menuitem id="menu_td_knowledge_reader" name="Articles" parent="menu_td_knowledge_root"
              action="action_td_knowledge_reader" sequence="1"/>
    <menuitem id="menu_td_knowledge_all" name="All articles" parent="menu_td_knowledge_root"
              action="action_td_knowledge_article" sequence="2" groups="group_td_knowledge_editor"/>
</odoo>

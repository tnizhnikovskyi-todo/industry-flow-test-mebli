<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_td_knowledge" model="res.groups.privilege">
        <field name="name">Knowledge Base</field>
        <field name="sequence">91</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_td_knowledge_editor" model="res.groups">
        <field name="name">Knowledge Base Editor</field>
        <field name="privilege_id" ref="res_groups_privilege_td_knowledge"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Writes and edits the articles of the knowledge base, links them to screens.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_td_knowledge_editor'))]"/>
    </record>

    <record id="td_knowledge_article_rule_reader" model="ir.rule">
        <field name="name">Knowledge article: readers of the article</field>
        <field name="model_id" ref="model_td_knowledge_article"/>
        <field name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="td_knowledge_article_rule_editor" model="ir.rule">
        <field name="name">Knowledge article: editors see all</field>
        <field name="model_id" ref="model_td_knowledge_article"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_td_knowledge_editor'))]"/>
    </record>
</odoo>

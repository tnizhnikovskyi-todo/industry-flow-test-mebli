<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_td_mebli_sign" model="ir.ui.view">
        <field name="name">sale.order.form.td_mebli_sign</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_td_send_sign" type="object" string="Sign the Contract (Sign)" invisible="state != 'sale'"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_mebli_timesheet_export_form" model="ir.ui.view">
        <field name="name">td.mebli.timesheet.export.form</field>
        <field name="model">td.mebli.timesheet.export</field>
        <field name="arch" type="xml">
            <form string="Time Sheet for BAS (imitation)">
                <div class="alert alert-light border small text-muted mb-2 td_bas_imitation" role="status">
                    Imitation of the exchange with BAS: the file is made from the standard attendances (kiosk with a PIN),
                    nothing is sent.
                </div>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group invisible="not filename">
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                        <field name="total_hours"/>
                    </group>
                </group>
                <field name="line_ids" invisible="not filename">
                    <list create="0" delete="0">
                        <field name="employee_id"/>
                        <field name="days"/>
                        <field name="hours"/>
                    </list>
                </field>
                <footer>
                    <button name="action_build" type="object" string="Build the File" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="td_mebli_timesheet_export_action" model="ir.actions.act_window">
        <field name="name">Time Sheet for BAS (imitation)</field>
        <field name="res_model">td.mebli.timesheet.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="td_mebli_timesheet_export_menu" name="Time Sheet for BAS" parent="hr_attendance.menu_hr_attendance_view_attendances_management"
              action="td_mebli_timesheet_export_action" sequence="50" groups="hr_attendance.group_hr_attendance_officer"/>
</odoo>

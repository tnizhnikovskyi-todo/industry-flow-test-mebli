<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_mebli_kit_line_view_list" model="ir.ui.view">
        <field name="name">td.mebli.kit.line.list</field>
        <field name="model">td.mebli.kit.line</field>
        <field name="arch" type="xml">
            <list string="Packing List" editable="bottom" create="0" decoration-muted="packed" decoration-danger="not packed">
                <field name="place"/>
                <field name="kind"/>
                <field name="label"/>
                <field name="item"/>
                <field name="qty"/>
                <field name="packed" widget="boolean_toggle"/>
                <field name="packed_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="part_id" column_invisible="True"/>
                <field name="reorder_production_id" string="Reordered" optional="show" readonly="1"/>
                <button name="action_td_reorder" type="object" string="Create additional order" icon="fa-repeat"
                        invisible="packed or reorder_production_id or not part_id"/>
            </list>
        </field>
    </record>

    <record id="td_mebli_kit_line_view_search" model="ir.ui.view">
        <field name="name">td.mebli.kit.line.search</field>
        <field name="model">td.mebli.kit.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="item"/>
                <filter name="missing" string="Not Packed" domain="[('packed', '=', False)]"/>
                <group>
                    <filter name="group_place" string="Place" context="{'group_by': 'place'}"/>
                    <filter name="group_order" string="Order" context="{'group_by': 'order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="td_mebli_kit_line_action" model="ir.actions.act_window">
        <field name="name">Packing Lists</field>
        <field name="res_model">td.mebli.kit.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_order': 1}</field>
    </record>

    <record id="view_order_form_td_mebli_shop" model="ir.ui.view">
        <field name="name">sale.order.form.td_mebli_shop</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_td_view_kit" type="object" class="oe_stat_button" icon="fa-cubes"
                        invisible="not td_kit_line_ids">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="td_kit_missing"/></span>
                        <span class="o_stat_text">Not Packed</span>
                    </div>
                </button>
                <field name="td_kit_line_ids" invisible="1"/>
            </div>
            <xpath expr="//header" position="inside">
                <!-- D-11 (AC-091): the warehouse builds the packing list of a confirmed order -->
                <button name="action_td_form_kit" type="object" string="Build the Packing List"
                        groups="stock.group_stock_user" invisible="state != 'sale' or td_kit_line_ids"/>
                <button name="action_td_scan_labels" type="object" string="Scan Labels"
                        groups="td_mebli_base.group_feature_label_scan" invisible="not td_kit_line_ids"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_td_mebli_shop" model="ir.ui.view">
        <field name="name">stock.picking.form.td_mebli_shop</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- D-11 (AC-091): the packing list from the delivery of the order (the storekeeper works in Inventory) -->
                <field name="sale_id" invisible="1"/>
                <button name="action_td_form_kit" type="object" string="Packing List" groups="stock.group_stock_user"
                        invisible="not sale_id or picking_type_code != 'outgoing' or state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>

    <record id="td_mebli_kit_scan_form" model="ir.ui.view">
        <field name="name">td.mebli.kit.scan.form</field>
        <field name="model">td.mebli.kit.scan</field>
        <field name="arch" type="xml">
            <form string="Scan Labels">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="code" placeholder="Scan the QR of a part label" default_focus="1"/>
                    <field name="last_scanned" invisible="not last_scanned"/>
                    <field name="missing"/>
                </group>
                <footer>
                    <button name="action_scan" type="object" string="Pack" class="btn-primary" data-hotkey="q"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="td_mebli_kit_menu" name="Packing Lists" parent="stock.menu_stock_warehouse_mgmt"
              action="td_mebli_kit_line_action" sequence="40"/>
</odoo>

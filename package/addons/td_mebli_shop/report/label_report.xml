<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Position 5 (F-29): labels of the parts with a QR code (standard barcode generator of the reports,
         ir.actions.report.barcode — the same as /report/barcode), from the packing list or the manufacturing order -->
    <record id="action_report_part_labels" model="ir.actions.report">
        <field name="name">Part Labels (QR)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">td_mebli_shop.report_part_labels</field>
        <field name="report_file">td_mebli_shop.report_part_labels</field>
        <field name="print_report_name">'Labels - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_mo_part_labels" model="ir.actions.report">
        <field name="name">Part Labels (QR)</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">td_mebli_shop.report_mo_part_labels</field>
        <field name="report_file">td_mebli_shop.report_mo_part_labels</field>
        <field name="print_report_name">'Labels - %s' % (object.name)</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_part_labels_grid">
        <div class="page td_report_labels">
            <div class="row g-0">
                <t t-foreach="rows" t-as="row">
                    <div class="col-4 p-1" style="page-break-inside: avoid;">
                        <div class="td_label border border-dark p-2" style="height: 44mm; overflow: hidden;">
                            <div class="d-flex">
                                <div style="width: 26mm;">
                                    <img t-att-src="env['ir.actions.report']._td_qr_data_uri(row['code'])" style="width:24mm;height:24mm" alt="QR"/>
                                </div>
                                <div class="ps-2 small" style="line-height: 1.25;">
                                    <div><strong t-out="row['item']"/></div>
                                    <div t-if="row['size']"><span t-out="row['size']"/> mm</div>
                                    <div t-if="row['material']" t-out="row['material']"/>
                                    <div>Qty: <t t-out="'%g' % row['qty']"/></div>
                                </div>
                            </div>
                            <div class="small mt-1 border-top pt-1">
                                <strong t-out="row['order']"/> · <t t-out="row['customer']"/>
                                <t t-if="row['place']"> · <strong>Place <t t-out="row['place']"/></strong></t>
                                <div class="text-muted td_label_code" t-out="row['code']"/>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            <p t-if="not rows">No parts to label.</p>
        </div>
    </template>

    <template id="report_part_labels">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-set="rows" t-value="doc._td_label_rows()"/>
                    <t t-call="td_mebli_shop.report_part_labels_grid"/>
                </t>
            </t>
        </t>
    </template>
    <template id="report_mo_part_labels">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-set="rows" t-value="doc._td_label_rows()"/>
                    <t t-call="td_mebli_shop.report_part_labels_grid"/>
                </t>
            </t>
        </t>
    </template>

    <!-- Position 11 (F-56): acceptance and transfer act without installation (sale only: pickup or delivery),
         printed from the standard delivery order -->
    <record id="action_report_handover_act" model="ir.actions.report">
        <field name="name">Acceptance and Transfer Act</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">td_mebli_shop.report_handover_act</field>
        <field name="report_file">td_mebli_shop.report_handover_act</field>
        <field name="print_report_name">'Transfer act - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_handover_act_document">
        <t t-call="web.external_layout">
            <t t-set="order" t-value="doc.sale_id"/>
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page td_report_handover">
                <h2>Acceptance and Transfer Act <span t-field="doc.name"/></h2>
                <p class="text-muted td_lawyer_mark">Template to be checked by a lawyer (No. 17)</p>
                <div class="row mb-3">
                    <div class="col-6"><strong>Seller:</strong> <span t-field="doc.company_id.name"/></div>
                    <div class="col-6"><strong>Buyer:</strong> <span t-field="doc.partner_id"/></div>
                </div>
                <div class="row mb-3">
                    <div class="col-4"><strong>Order:</strong> <span t-out="order.name or doc.origin or ''"/></div>
                    <div class="col-4"><strong>Address:</strong> <span t-out="', '.join(filter(None, [doc.partner_id.street, doc.partner_id.city]))"/></div>
                    <div class="col-4"><strong>Date:</strong> <span t-field="doc.scheduled_date" t-options="{'widget': 'date'}"/></div>
                </div>
                <p>The seller hands over and the buyer accepts the goods of the order without installation:</p>
                <table class="table table-sm o_main_table">
                    <thead><tr><th>Goods</th><th class="text-end">Quantity</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr t-foreach="doc.move_ids.filtered(lambda m: m.state != 'cancel')" t-as="move">
                            <td><span t-field="move.product_id.name"/></td>
                            <td class="text-end"><span t-out="'%g' % (move.quantity or move.product_uom_qty)"/></td>
                            <td><span t-field="move.product_uom"/></td>
                        </tr>
                    </tbody>
                </table>
                <p t-if="order and order.td_kit_places">Places: <t t-out="order.td_kit_places"/> (by the packing list of the order).</p>
                <p>The goods are checked by the buyer for completeness and visible defects. Claims on the quantity and the
                    appearance: ______________________________________________</p>
                <p>The warranty is given under the contract; assembly and installation by the buyer or a third party are
                    not covered by the warranty of installation.</p>
                <div class="row mt-5">
                    <div class="col-6">Handed over (seller): ____________________</div>
                    <div class="col-6">Accepted (buyer): ____________________</div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_handover_act">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="td_mebli_shop.report_handover_act_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>

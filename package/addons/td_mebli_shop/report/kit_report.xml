<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Printed packing list of the order (A-21, coverage review A2): places, items, labels, «packed» and who packed.
         It goes with the delivery: the crew checks the places on arrival. -->
    <record id="action_report_kit" model="ir.actions.report">
        <field name="name">Packing List</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">td_mebli_shop.report_kit</field>
        <field name="report_file">td_mebli_shop.report_kit</field>
        <field name="print_report_name">'Packing list - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_kit_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="address">
                <div t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
            </t>
            <div class="page td_mebli_report td_report_kit">
                <h2>Packing List <span t-field="doc.name"/></h2>
                <div class="row mb-3">
                    <div class="col-4"><strong>Places:</strong> <span t-field="doc.td_kit_places"/></div>
                    <div class="col-4"><strong>Items:</strong> <t t-out="len(doc.td_kit_line_ids)"/></div>
                    <div class="col-4"><strong>Not packed:</strong> <span t-field="doc.td_kit_missing"/></div>
                </div>
                <p t-if="not doc.td_kit_line_ids">The packing list of the order is not built yet.</p>
                <t t-foreach="doc._td_kit_by_place()" t-as="group">
                    <t t-set="place" t-value="group[0]"/>
                    <t t-set="lines" t-value="group[1]"/>
                    <h5 class="mt-3">Place <t t-out="place"/> — <span t-field="lines[:1].kind"/></h5>
                    <table class="table table-sm o_main_table">
                        <thead><tr><th>Label</th><th>Item</th><th class="text-end">Quantity</th><th class="text-center">Packed</th><th>Packed by</th></tr></thead>
                        <tbody>
                            <tr t-foreach="lines" t-as="line">
                                <td><span t-field="line.label"/></td>
                                <td><span t-field="line.item"/></td>
                                <td class="text-end"><span t-field="line.qty"/></td>
                                <td class="text-center"><t t-if="line.packed">✓</t><t t-else="">—</t></td>
                                <td><span t-field="line.packed_by_id"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <div class="row mt-4">
                    <div class="col-6">Packed by the warehouse: ____________________</div>
                    <div class="col-6">Places received by the crew: ____________________</div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_kit">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="td_mebli_shop.report_kit_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>

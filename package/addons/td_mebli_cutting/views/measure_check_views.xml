<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Position 28: the design against the measurement before cutting -->
    <record id="td_mebli_cutting_job_form_td_measure" model="ir.ui.view">
        <field name="name">td.mebli.cutting.job.form.measure</field>
        <field name="model">td.mebli.cutting.job</field>
        <field name="inherit_id" ref="td_mebli_cutting.td_mebli_cutting_job_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0 td_measure_alert" role="alert"
                     invisible="not td_measure_problems or state != 'draft'">
                    <i class="fa fa-exclamation-triangle me-2" title="Check before cutting"/>
                    <strong>The design does not match the measurement:</strong>
                    <field name="td_measure_problems" class="d-block mt-1"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="td_mebli_measure_warning_form" model="ir.ui.view">
        <field name="name">td.mebli.measure.warning.form</field>
        <field name="model">td.mebli.measure.warning</field>
        <field name="arch" type="xml">
            <form string="Check before Cutting">
                <div class="alert alert-warning td_measure_warning" role="alert">
                    <strong>The design of the order does not match the measurement sheet.</strong>
                    Check with the measurer and the designer before the board is cut.
                </div>
                <field name="problems" class="td_measure_warning_text"/>
                <field name="method" invisible="1"/>
                <footer>
                    <button string="Back, fix the design" special="cancel" class="btn-primary"/>
                    <button name="action_confirm" type="object" string="Send anyway" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

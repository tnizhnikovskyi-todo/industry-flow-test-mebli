<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_mebli_cutting_result_import_form" model="ir.ui.view">
        <field name="name">td.mebli.cutting.result.import.form</field>
        <field name="model">td.mebli.cutting.result.import</field>
        <field name="arch" type="xml">
            <form string="Import Result">
                <p class="text-muted">CSV of the cutting map from the cutting program: one row per placed part or offcut —
                    sheet; material; sheet_length; sheet_width; lot; type (part / offcut); code (code of the part from
                    the cutting file); x; y; length; width; rotated.</p>
                <group>
                    <field name="job_id" readonly="1"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="td_mebli_offcut_pick_form" model="ir.ui.view">
        <field name="name">td.mebli.offcut.pick.form</field>
        <field name="model">td.mebli.offcut.pick</field>
        <field name="arch" type="xml">
            <form string="Pick an Offcut">
                <group>
                    <field name="job_id" readonly="1"/>
                    <field name="part_id" readonly="1"/>
                    <field name="candidate_ids" invisible="1"/>
                </group>
                <field name="candidate_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="td_length_mm"/>
                        <field name="td_width_mm"/>
                        <field name="td_area_m2"/>
                    </list>
                </field>
                <group>
                    <field name="lot_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_reserve" type="object" string="Reserve for the Job" class="btn-primary"
                            invisible="not lot_id"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

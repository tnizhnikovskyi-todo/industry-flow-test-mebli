<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_td_forecast_activity" model="ir.cron">
        <field name="name">Furniture: activities on the forecast date shift</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_td_forecast_activity()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_td_customer_reminders" model="ir.cron">
        <field name="name">Furniture: reminders to the customers</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_td_customer_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 07:00:00')"/>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_td_morning_briefing" model="ir.cron">
        <field name="name">Furniture: morning briefing of the owner</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_td_morning_briefing()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:30:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>

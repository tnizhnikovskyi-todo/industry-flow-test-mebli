#. module: td_mebli_notify
#: model:mail.template,body_html:td_mebli_notify.mail_template_td_briefing
msgid ""
"<div style=\"margin: 0px; padding: 0px;\" class=\"td_briefing\">\n"
"    <t t-set=\"data\" t-value=\"briefing or object.env['td.mebli.dashboard']._td_briefing_data()\"/>\n"
"    <!-- AC-125: nothing to report &#8212; one short line, no empty sections -->\n"
"    <p t-if=\"data['nothing']\" class=\"td_briefing_nothing\"><strong>No deviations</strong></p>\n"
"    <t t-else=\"\">\n"
"        <t t-if=\"data['at_risk']\">\n"
"            <p><strong>Orders at risk: <t t-out=\"len(data['at_risk'])\"/></strong></p>\n"
"            <ul>\n"
"                <li t-foreach=\"data['at_risk'][:8]\" t-as=\"row\"><t t-out=\"row['name']\"/> · <t t-out=\"row['customer']\"/> · +<t t-out=\"row['days']\"/> d. · <t t-out=\"row['reason']\"/></li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"data['claims']\">\n"
"            <p><strong>Overdue claims: <t t-out=\"len(data['claims'])\"/></strong></p>\n"
"            <ul>\n"
"                <li t-foreach=\"data['claims'][:8]\" t-as=\"row\"><t t-out=\"row['name']\"/> · <t t-out=\"row['customer']\"/> · <t t-out=\"row['days']\"/> d.</li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"data['due_after_act_count'] or data['due_before_count']\">\n"
"            <p><strong>Money to receive</strong></p>\n"
"            <ul>\n"
"                <li t-if=\"data['due_after_act_count']\">After the signed final act: <t t-out=\"data['due_after_act']\"/> (orders: <t t-out=\"data['due_after_act_count']\"/>)</li>\n"
"                <li t-if=\"data['due_before_count']\">Before the installations of the next 7 days: <t t-out=\"data['due_before']\"/> (orders: <t t-out=\"data['due_before_count']\"/>)</li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"data['stuck']\">\n"
"            <p><strong>Stuck orders: <t t-out=\"len(data['stuck'])\"/></strong></p>\n"
"            <ul>\n"
"                <li t-foreach=\"data['stuck'][:8]\" t-as=\"row\"><t t-out=\"row['name']\"/> · <t t-out=\"row['customer']\"/> · <t t-out=\"row['days']\"/> d. without a move</li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"data['overdue']\">\n"
"            <p><strong>Overdue manufacturing orders: <t t-out=\"len(data['overdue'])\"/></strong></p>\n"
"            <ul>\n"
"                <li t-foreach=\"data['overdue'][:8]\" t-as=\"row\"><t t-out=\"row['name']\"/> · <t t-out=\"row['origin']\"/> · <t t-out=\"row['days']\"/> d. late</li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"data['downtime']\">\n"
"            <p><strong>Downtime of the sections yesterday</strong></p>\n"
"            <ul>\n"
"                <li t-foreach=\"data['downtime']\" t-as=\"row\"><t t-out=\"row['center']\"/> · <t t-out=\"row['reason']\"/> · <t t-out=\"row['hours']\"/> h</li>\n"
"            </ul>\n"
"        </t>\n"
"    </t>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\" class=\"td_briefing\">\n"
"    <t t-set=\"data\" t-value=\"briefing or object.env['td.mebli.dashboard']._td_briefing_data()\"/>\n"
"    <!-- AC-125: nothing to report &#8212; one short line, no empty sections -->\n"
"    <p t-if=\"data['nothing']\" class=\"td_briefing_nothing\"><strong>Відхилень немає</strong></p>\n"
"    <t t-else=\"\">\n"
"        <t t-if=\"data['at_risk']\">\n"
"            <p><strong>Замовлення під загрозою: <t t-out=\"len(data['at_risk'])\"/></strong></p>\n"
"            <ul>\n"
"                <li t-foreach=\"data['at_risk'][:8]\" t-as=\"row\"><t t-out=\"row['name']\"/> · <t t-out=\"row['customer']\"/> · +<t t-out=\"row['days']\"/> дн. · <t t-out=\"row['reason']\"/></li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"data['claims']\">\n"
"            <p><strong>Прострочені рекламації: <t t-out=\"len(data['claims'])\"/></strong></p>\n"
"            <ul>\n"
"                <li t-foreach=\"data['claims'][:8]\" t-as=\"row\"><t t-out=\"row['name']\"/> · <t t-out=\"row['customer']\"/> · <t t-out=\"row['days']\"/> дн.</li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"data['due_after_act_count'] or data['due_before_count']\">\n"
"            <p><strong>Гроші до отримання</strong></p>\n"
"            <ul>\n"
"                <li t-if=\"data['due_after_act_count']\">Після підписаного фінального акта: <t t-out=\"data['due_after_act']\"/> (замовлень: <t t-out=\"data['due_after_act_count']\"/>)</li>\n"
"                <li t-if=\"data['due_before_count']\">Перед монтажами найближчих 7 днів: <t t-out=\"data['due_before']\"/> (замовлень: <t t-out=\"data['due_before_count']\"/>)</li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"data['stuck']\">\n"
"            <p><strong>Застряглі замовлення: <t t-out=\"len(data['stuck'])\"/></strong></p>\n"
"            <ul>\n"
"                <li t-foreach=\"data['stuck'][:8]\" t-as=\"row\"><t t-out=\"row['name']\"/> · <t t-out=\"row['customer']\"/> · <t t-out=\"row['days']\"/> дн. без руху</li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"data['overdue']\">\n"
"            <p><strong>Прострочені виробничі замовлення: <t t-out=\"len(data['overdue'])\"/></strong></p>\n"
"            <ul>\n"
"                <li t-foreach=\"data['overdue'][:8]\" t-as=\"row\"><t t-out=\"row['name']\"/> · <t t-out=\"row['origin']\"/> · <t t-out=\"row['days']\"/> дн. запізнення</li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"data['downtime']\">\n"
"            <p><strong>Простої дільниць учора</strong></p>\n"
"            <ul>\n"
"                <li t-foreach=\"data['downtime']\" t-as=\"row\"><t t-out=\"row['center']\"/> · <t t-out=\"row['reason']\"/> · <t t-out=\"row['hours']\"/> год</li>\n"
"            </ul>\n"
"        </t>\n"
"    </t>\n"
"</div>\n"
"        "

#. module: td_mebli_notify
#: model:mail.template,body_html:td_mebli_notify.mail_template_td_measure_booking
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello!</p>\n"
"    <p>Our measurer <t t-out=\"object.user_id.name or ''\"/> comes to you\n"
"        <strong t-out=\"format_datetime(object.start, tz=object.user_id.tz or 'Europe/Kyiv', dt_format='dd.MM.yyyy HH:mm')\"/>.</p>\n"
"    <p t-if=\"object.location\">The address: <strong t-out=\"object.location\"/>.</p>\n"
"    <p>Please prepare the plan of the room and the sizes of your appliances if you have them.</p>\n"
"    <p>Best regards, <t t-out=\"object.user_id.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Вітаємо!</p>\n"
"    <p>Наш замірник <t t-out=\"object.user_id.name or ''\"/> приїде до вас\n"
"        <strong t-out=\"format_datetime(object.start, tz=object.user_id.tz or 'Europe/Kyiv', dt_format='dd.MM.yyyy HH:mm')\"/>.</p>\n"
"    <p t-if=\"object.location\">Адреса: <strong t-out=\"object.location\"/>.</p>\n"
"    <p>Підготуйте, будь ласка, план приміщення й розміри вашої техніки, якщо вони є.</p>\n"
"    <p>З повагою, <t t-out=\"object.user_id.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "

#. module: td_mebli_notify
#: model:mail.template,body_html:td_mebli_notify.mail_template_td_new_date
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello, <t t-out=\"object.partner_id.name or ''\"/>!</p>\n"
"    <p>The date of your order <strong t-out=\"object.name or ''\"/> has moved.\n"
"        The new date: <strong t-out=\"format_date(object.td_forecast_date or object.commitment_date)\"/>.</p>\n"
"    <p t-if=\"object.td_delay_reason == 'supplier'\">The reason: a supplier delivers a part of the order later than planned.</p>\n"
"    <p>We apologize and will keep you informed. If the new date does not suit you, please answer this letter.</p>\n"
"    <p>Best regards, <t t-out=\"object.user_id.name or object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Добрий день, <t t-out=\"object.partner_id.name or ''\"/>!</p>\n"
"    <p>Дата вашого замовлення <strong t-out=\"object.name or ''\"/> змінилась.\n"
"        Нова дата: <strong t-out=\"format_date(object.td_forecast_date or object.commitment_date)\"/>.</p>\n"
"    <p t-if=\"object.td_delay_reason == 'supplier'\">Причина: постачальник привозить частину замовлення пізніше, ніж планувалось.</p>\n"
"    <p>Перепрошуємо й тримаємо вас у курсі. Якщо нова дата вам не підходить, відповідайте на цей лист.</p>\n"
"    <p>З повагою, <t t-out=\"object.user_id.name or object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "

#. module: td_mebli_notify
#: model:mail.template,body_html:td_mebli_notify.mail_template_td_payment_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello, <t t-out=\"object.partner_id.name or ''\"/>!</p>\n"
"    <p>The installation of your order <strong t-out=\"object.name or ''\"/> is coming. Under the payment terms the payment\n"
"        before the installation is due: <strong t-out=\"format_amount(object.td_pay_missing, object.currency_id)\"/>.</p>\n"
"    <p>Paid so far: <t t-out=\"format_amount(object.td_pay_received, object.currency_id)\"/>.</p>\n"
"    <p>If you have already paid, please ignore this letter.</p>\n"
"    <p>Best regards, <t t-out=\"object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Добрий день, <t t-out=\"object.partner_id.name or ''\"/>!</p>\n"
"    <p>Наближається монтаж вашого замовлення <strong t-out=\"object.name or ''\"/>. За умовами оплати перед монтажем\n"
"        потрібно доплатити: <strong t-out=\"format_amount(object.td_pay_missing, object.currency_id)\"/>.</p>\n"
"    <p>Уже сплачено: <t t-out=\"format_amount(object.td_pay_received, object.currency_id)\"/>.</p>\n"
"    <p>Якщо ви вже сплатили, не зважайте на цей лист.</p>\n"
"    <p>З повагою, <t t-out=\"object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "

#. module: td_mebli_notify
#: model:mail.template,body_html:td_mebli_notify.mail_template_td_install_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello, <t t-out=\"object.sale_order_id.partner_id.name or ''\"/>!</p>\n"
"    <p>Our crew comes tomorrow, <strong t-out=\"format_datetime(object.date_deadline, tz=object.sale_order_id.partner_id.tz or 'Europe/Kyiv', dt_format='dd.MM.yyyy HH:mm')\"/>,\n"
"        to install your order <strong t-out=\"object.sale_order_id.name or ''\"/>.</p>\n"
"    <p>Please make sure the room is free and there is access to sockets and water.</p>\n"
"    <p>Best regards, <t t-out=\"object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Добрий день, <t t-out=\"object.sale_order_id.partner_id.name or ''\"/>!</p>\n"
"    <p>Наша бригада приїде завтра, <strong t-out=\"format_datetime(object.date_deadline, tz=object.sale_order_id.partner_id.tz or 'Europe/Kyiv', dt_format='dd.MM.yyyy HH:mm')\"/>,\n"
"        монтувати ваше замовлення <strong t-out=\"object.sale_order_id.name or ''\"/>.</p>\n"
"    <p>Будь ласка, звільніть приміщення й забезпечте доступ до розеток і води.</p>\n"
"    <p>З повагою, <t t-out=\"object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "

#. module: td_mebli_notify
#: model:mail.template,body_html:td_mebli_notify.mail_template_td_install_date
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello, <t t-out=\"object.sale_order_id.partner_id.name or ''\"/>!</p>\n"
"    <p>The installation of your order <strong t-out=\"object.sale_order_id.name or ''\"/> is planned on\n"
"        <strong t-out=\"format_datetime(object.date_deadline, tz=object.sale_order_id.partner_id.tz or 'Europe/Kyiv', dt_format='dd.MM.yyyy HH:mm')\"/>.</p>\n"
"    <p t-if=\"object.sale_order_id.partner_shipping_id.contact_address\">The address:\n"
"        <t t-out=\"object.sale_order_id.partner_shipping_id.contact_address\"/>.</p>\n"
"    <p t-if=\"object.sale_order_id\">Amount of the order: <t t-out=\"format_amount(object.sale_order_id.amount_total, object.sale_order_id.currency_id)\"/>.</p>\n"
"    <p>Best regards, <t t-out=\"object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Вітаємо, <t t-out=\"object.sale_order_id.partner_id.name or ''\"/>!</p>\n"
"    <p>Монтаж вашого замовлення <strong t-out=\"object.sale_order_id.name or ''\"/> заплановано на\n"
"        <strong t-out=\"format_datetime(object.date_deadline, tz=object.sale_order_id.partner_id.tz or 'Europe/Kyiv', dt_format='dd.MM.yyyy HH:mm')\"/>.</p>\n"
"    <p t-if=\"object.sale_order_id.partner_shipping_id.contact_address\">Адреса:\n"
"        <t t-out=\"object.sale_order_id.partner_shipping_id.contact_address\"/>.</p>\n"
"    <p t-if=\"object.sale_order_id\">Сума замовлення: <t t-out=\"format_amount(object.sale_order_id.amount_total, object.sale_order_id.currency_id)\"/>.</p>\n"
"    <p>З повагою, <t t-out=\"object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_mebli_install_act_view_form" model="ir.ui.view">
        <field name="name">td.mebli.install.act.form</field>
        <field name="model">td.mebli.install.act</field>
        <field name="arch" type="xml">
            <form string="Installation Act">
                <header>
                    <button name="action_sign" type="object" string="Sign the Act" class="btn-primary" invisible="state == 'signed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="defect_open_count == 0">
                        Open defects: <field name="defect_open_count" class="d-inline"/>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="task_id"/>
                            <field name="order_id"/>
                            <field name="kind"/>
                            <field name="crew_user_ids" widget="many2many_avatar_user"/>
                        </group>
                        <group>
                            <field name="crew_pct" invisible="kind != 'final'"/>
                            <field name="crew_amount" invisible="kind != 'final'"/>
                            <field name="photo_archive"/>
                            <field name="signed_on" invisible="state != 'signed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Defects" name="defects">
                            <field name="defect_ids">
                                <list editable="bottom" decoration-muted="resolved">
                                    <field name="name"/>
                                    <field name="photo" widget="image" options="{'size': [48, 48]}"/>
                                    <field name="resolved" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Photos and Checklist" name="photos">
                            <group>
                                <field name="photo_ids" widget="many2many_binary"/>
                                <field name="checklist"/>
                            </group>
                        </page>
                        <page string="Signature" name="signature">
                            <group>
                                <field name="signed_by" readonly="state == 'signed'"/>
                                <field name="signature" widget="signature" readonly="state == 'signed'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="td_mebli_install_act_view_list" model="ir.ui.view">
        <field name="name">td.mebli.install.act.list</field>
        <field name="model">td.mebli.install.act</field>
        <field name="arch" type="xml">
            <list string="Installation Acts" decoration-warning="defect_open_count &gt; 0">
                <field name="name"/>
                <field name="order_id"/>
                <field name="task_id"/>
                <field name="kind"/>
                <field name="defect_open_count"/>
                <field name="crew_amount" sum="Total"/>
                <field name="photo_archive" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'signed'"/>
            </list>
        </field>
    </record>

    <record id="td_mebli_install_act_view_search" model="ir.ui.view">
        <field name="name">td.mebli.install.act.search</field>
        <field name="model">td.mebli.install.act</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="order_id"/>
                <filter name="signed" string="Signed" domain="[('state', '=', 'signed')]"/>
                <separator/>
                <filter name="archive" string="In the Photo Archive" domain="[('photo_archive', '=', True)]"/>
                <separator/>
                <filter name="final" string="Final Acts" domain="[('kind', '=', 'final')]"/>
            </search>
        </field>
    </record>

    <record id="td_mebli_install_act_action" model="ir.actions.act_window">
        <field name="name">Installation Acts</field>
        <field name="res_model">td.mebli.install.act</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="td_mebli_install_calendar_action" model="ir.actions.act_window">
        <field name="name">Installation Calendar</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('sale_order_id', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'calendar', 'view_id': ref('project.view_task_calendar')})]"/>
        <field name="help">Visits of the installation crews: a standard task of the order with the date of the visit.</field>
    </record>

    <record id="view_task_form2_td_mebli_install" model="ir.ui.view">
        <field name="name">project.task.form.td_mebli_install</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_td_view_acts" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not sale_order_id">
                    <field name="td_act_count" widget="statinfo" string="Acts"/>
                </button>
                <field name="sale_order_id" invisible="1"/>
            </div>
        </field>
    </record>

    <menuitem id="td_mebli_install_menu" name="Installation" parent="project.menu_main_pm" sequence="5"/>
    <menuitem id="td_mebli_install_calendar_menu" name="Installation Calendar" parent="td_mebli_install_menu"
              action="td_mebli_install_calendar_action" sequence="1"/>
    <menuitem id="td_mebli_install_act_menu" name="Installation Acts" parent="td_mebli_install_menu"
              action="td_mebli_install_act_action" sequence="2"/>
</odoo>

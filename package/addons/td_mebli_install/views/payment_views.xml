<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- the order: the payment due before the installation (read only, from the invoices of the order) -->
    <record id="view_order_form_td_mebli_pay" model="ir.ui.view">
        <field name="name">sale.order.form.td.mebli.pay</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="td_pay_ok" invisible="1"/>
                <field name="td_stage" invisible="1"/>
                <div class="alert alert-warning mb-0 td_pay_alert" role="alert"
                     invisible="td_pay_ok or state != 'sale' or td_stage in ('closed', 'progress', 'confirmed')">
                    <i class="fa fa-money me-2" title="Payment before installation"/>
                    <strong>No payment before the installation: <field name="td_pay_missing" class="oe_inline"/> missing.</strong>
                    <span> Received <field name="td_pay_received" class="oe_inline"/> of <field name="td_pay_before_install" class="oe_inline"/> due before the visit of the crew.</span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- the visit: warning and «Start the installation» -->
    <record id="view_task_form2_td_mebli_pay" model="ir.ui.view">
        <field name="name">project.task.form.td.mebli.pay</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_td_start_install" type="object" string="Start the Installation" class="btn-primary"
                        invisible="not sale_order_id or td_act_count or state in ('1_done', '1_canceled')"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="td_pay_ok" invisible="1"/>
                <field name="td_pay_control" invisible="1"/>
                <field name="td_order_currency_id" invisible="1"/>
                <div class="alert alert-warning mb-0 td_pay_alert" role="alert"
                     invisible="not sale_order_id or td_pay_ok or td_pay_control == 'block' or state in ('1_done', '1_canceled')">
                    <i class="fa fa-money me-2" title="Payment before installation"/>
                    <strong>The order is not paid before the installation: <field name="td_pay_missing" class="oe_inline"/> missing.</strong>
                    <span> Call the customer before the crew leaves.</span>
                </div>
                <div class="alert alert-danger mb-0 td_pay_alert" role="alert"
                     invisible="not sale_order_id or td_pay_ok or td_pay_control != 'block' or state in ('1_done', '1_canceled')">
                    <i class="fa fa-ban me-2" title="Installation blocked"/>
                    <strong>The order is not paid before the installation: <field name="td_pay_missing" class="oe_inline"/> missing.</strong>
                    <span> The installation is blocked until the payment.</span>
                </div>
            </xpath>
        </field>
    </record>

    <record id="td_mebli_install_act_view_form_pay" model="ir.ui.view">
        <field name="name">td.mebli.install.act.form.pay</field>
        <field name="model">td.mebli.install.act</field>
        <field name="inherit_id" ref="td_mebli_install.td_mebli_install_act_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('alert-warning')]" position="before">
                <field name="pay_ok" invisible="1"/>
                <field name="pay_control" invisible="1"/>
                <div class="alert alert-warning td_pay_alert" role="alert" invisible="pay_ok or state == 'signed'">
                    <i class="fa fa-money me-2" title="Payment before installation"/>
                    <strong>The order is not paid before the installation: <field name="pay_missing" class="oe_inline"/> missing.</strong>
                    <span invisible="pay_control == 'block'"> The act can be signed; the manager is warned.</span>
                    <span invisible="pay_control != 'block'"> The act is signed after the payment.</span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- the order board: a payment badge on the cards after «Made» -->
    <record id="view_order_kanban_td_mebli_pay" model="ir.ui.view">
        <field name="name">sale.order.kanban.td.mebli.pay</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="td_mebli_sale.view_order_kanban_td_mebli"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="td_pay_ok"/>
                <field name="td_stage"/>
            </xpath>
            <xpath expr="//footer" position="before">
                <div t-if="!record.td_pay_ok.raw_value and ['done', 'wait', 'shipped', 'install'].includes(record.td_stage.raw_value)"
                     class="small text-danger mt-1 td_pay_badge"><i class="fa fa-money me-1" title="Payment"/>no payment: <field name="td_pay_missing" widget="monetary"/></div>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_td_mebli_install" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.td.mebli.install</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='project']" position="inside">
                <block title="Furniture Installation" name="td_mebli_install">
                    <setting id="td_mebli_payment_control" string="Payment before Installation"
                             help="The lines of the payment terms that are not «After the act» are due before the visit of the crew.">
                        <field name="td_mebli_payment_control" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

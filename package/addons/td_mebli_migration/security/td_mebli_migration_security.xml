<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_td_mebli_migration_check_company" model="ir.rule">
        <field name="name">Migration reconciliation: multi-company</field>
        <field name="model_id" ref="model_td_mebli_migration_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- review A-11 (AC-036): the lines follow the company of the reconciliation -->
    <record id="rule_td_mebli_migration_check_line_company" model="ir.rule">
        <field name="name">Migration reconciliation line: multi-company</field>
        <field name="model_id" ref="model_td_mebli_migration_check_line"/>
        <field name="domain_force">[('check_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>

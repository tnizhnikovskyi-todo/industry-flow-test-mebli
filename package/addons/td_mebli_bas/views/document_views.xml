<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- external codes of BAS (company dependent) -->
    <record id="view_partner_form_td_mebli_bas" model="ir.ui.view">
        <field name="name">res.partner.form.td_mebli_bas</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="td_bas_code"/>
            </field>
        </field>
    </record>
    <record id="product_normal_form_view_td_mebli_bas" model="ir.ui.view">
        <field name="name">product.product.form.td_mebli_bas</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="td_bas_code"/>
            </xpath>
        </field>
    </record>
    <record id="view_employee_form_td_mebli_bas" model="ir.ui.view">
        <field name="name">hr.employee.form.td_mebli_bas</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="td_bas_code" groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>

    <!-- invoice: status of the exchange (AC-039…AC-041) -->
    <record id="view_move_form_td_mebli_bas" model="ir.ui.view">
        <field name="name">account.move.form.td_mebli_bas</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="status" invisible="td_bas_state != 'sent'">
                    Sent to BAS (<field name="td_bas_batch_id" readonly="1" class="oe_inline"/>): corrections only by a reversal.
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="td_bas_state != 'error'">
                    Exchange error with BAS: see the log of the batch and «Retry».
                </div>
                <field name="td_bas_state" invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_invoice_tree_td_mebli_bas" model="ir.ui.view">
        <field name="name">account.move.list.td_mebli_bas</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="after">
                <field name="td_bas_state" optional="show" widget="badge" decoration-success="td_bas_state == 'sent'"
                       decoration-danger="td_bas_state == 'error'"/>
            </field>
        </field>
    </record>

    <!-- order: «Send to BAS» replaces the imitation of the slice -->
    <record id="view_order_form_td_mebli_bas" model="ir.ui.view">
        <field name="name">sale.order.form.td_mebli_bas</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_td_send_bas" type="object" string="Send to BAS" groups="td_mebli_base.group_finance"
                        invisible="state != 'sale' or td_bas_state == 'sent' or invoice_count == 0"/>
            </xpath>
            <field name="payment_term_id" position="after">
                <field name="td_bas_state" widget="badge" decoration-success="td_bas_state == 'sent'"
                       decoration-danger="td_bas_state == 'error'" invisible="state != 'sale'"/>
            </field>
        </field>
    </record>

    <!-- accruals (AC-109) -->
    <record id="td_mebli_accrual_view_list_td_mebli_bas" model="ir.ui.view">
        <field name="name">td.mebli.accrual.list.td_mebli_bas</field>
        <field name="model">td.mebli.accrual</field>
        <field name="inherit_id" ref="td_mebli_install.td_mebli_accrual_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_td_send_bas" type="object" string="Send to BAS" groups="td_mebli_base.group_finance"/>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="bas_state" optional="show" widget="badge" decoration-success="bas_state == 'sent'"
                       decoration-danger="bas_state == 'error'"/>
            </xpath>
        </field>
    </record>

    <!-- time sheet (AC-078) -->
    <record id="td_mebli_timesheet_export_form_td_mebli_bas" model="ir.ui.view">
        <field name="name">td.mebli.timesheet.export.form.td_mebli_bas</field>
        <field name="model">td.mebli.timesheet.export</field>
        <field name="inherit_id" ref="td_mebli_attendance.td_mebli_timesheet_export_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='action_build']" position="after">
                <button name="action_td_send_bas" type="object" string="Send to BAS" invisible="not filename"
                        groups="td_mebli_base.group_finance"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- tr/security.md §1: privilege «Furniture»; the role groups of the slice (measurer, director) stay in their modules
         until the move with migrations/ (AC-N.04). -->
    <record id="res_groups_privilege_mebli" model="res.groups.privilege">
        <field name="name">Furniture</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="sequence">60</field>
        <field name="privilege_id" ref="res_groups_privilege_mebli"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">ROLE-06: payments, accruals, exchange with the accounting; sees costs and margins.</field>
    </record>

    <record id="group_margin_view" model="res.groups">
        <field name="name">Furniture: Sees the Margin</field>
        <field name="comment">Set automatically by the parameter of the company «Salesman Sees the Margin» (VP-08, AC-018).</field>
    </record>

    <!-- Feature groups of box B (VP-02, tr/00-architecture.md §3): only visibility flags of menus, buttons and fields;
         switched on in the settings (implied by base.group_user). Menus get groups= in their own modules. -->
    <record id="group_feature_configurator" model="res.groups">
        <field name="name">Furniture feature: Configurator</field>
        <field name="comment">Box B function «configurator» (VP-02).</field>
    </record>
    <record id="group_feature_offcut" model="res.groups">
        <field name="name">Furniture feature: Offcuts</field>
        <field name="comment">Box B function «offcut» (VP-02).</field>
    </record>
    <record id="group_feature_cutting_batch" model="res.groups">
        <field name="name">Furniture feature: Cutting Batches</field>
        <field name="comment">Box B function «cutting_batch» (VP-02).</field>
    </record>
    <record id="group_feature_kiosk" model="res.groups">
        <field name="name">Furniture feature: Workshop Kiosk</field>
        <field name="comment">Box B function «kiosk» (VP-02).</field>
    </record>
    <record id="group_feature_quality" model="res.groups">
        <field name="name">Furniture feature: Quality Control</field>
        <field name="comment">Box B function «quality» (VP-02).</field>
    </record>
    <record id="group_feature_label_scan" model="res.groups">
        <field name="name">Furniture feature: Label Scanning</field>
        <field name="comment">Box B function «label_scan» (VP-02).</field>
    </record>
    <record id="group_feature_change_sign" model="res.groups">
        <field name="name">Furniture feature: Signature of Order Changes</field>
        <field name="comment">Box B function «change_sign» (VP-02).</field>
    </record>
    <record id="group_feature_nbu" model="res.groups">
        <field name="name">Furniture feature: NBU Exchange Rates</field>
        <field name="comment">Box B function «nbu» (VP-02).</field>
    </record>
    <record id="group_feature_ai_mapping" model="res.groups">
        <field name="name">Furniture feature: AI Column Mapping</field>
        <field name="comment">Box B function «ai_mapping» (VP-02).</field>
    </record>
    <record id="group_feature_analog" model="res.groups">
        <field name="name">Furniture feature: Analogs</field>
        <field name="comment">Box B function «analog» (VP-02).</field>
    </record>
    <record id="group_feature_shop_board" model="res.groups">
        <field name="name">Furniture feature: Workshop Board</field>
        <field name="comment">Box B function «shop_board» (VP-02).</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- мобільне подання рядків: кнопки розділу й примітки беруть переклад із цього подання (у стандартному вони лишались англійською) -->
    <record id="view_order_form_td_mebli_mobile" model="ir.ui.view">
        <field name="name">sale.order.form.td.mebli.mobile</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- кнопки «розділ» і «примітка» у мобільному поданні лишались англійською — для замовлення виробу вони не потрібні -->
            <xpath expr="//field[@name='order_line']/kanban/control/create[@name='add_section_control']" position="replace"/>
            <xpath expr="//field[@name='order_line']/kanban/control/create[@name='add_note_control']" position="replace"/>
            <!-- на телефоні стандартна форма рядка вибирає лише варіант (product_id) і не відкриває конфігуратор: додаємо вибір шаблону з тим самим
                 віджетом, що в списку на комп'ютері — тоді відкривається адаптивний діалог конфігуратора (декор, кромка, фурнітура) -->
            <xpath expr="//field[@name='order_line']/form//label[@for='product_id']" position="before">
                <label for="product_template_id" string="Product"/>
                <field name="product_template_id" widget="sol_product_many2one" readonly="not product_updatable" required="not display_type and not is_downpayment"
                       context="{'default_list_price': price_unit, 'default_uom_id': product_uom_id, 'partner_id': parent.partner_id}"
                       options="{'show_label_warning': True}" placeholder="Type to find a product..."/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//label[@for='product_id']" position="before">
                <!-- поля, які конфігуратор записує в рядок: у формі їх немає, без них застосування вибору падає -->
                <field name="product_custom_attribute_value_ids" invisible="1">
                    <list><field name="custom_product_template_attribute_value_id"/><field name="custom_value"/></list>
                </field>
                <field name="product_no_variant_attribute_value_ids" invisible="1"/>
                <field name="technical_price_unit" invisible="1"/>
                <field name="linked_line_id" invisible="1"/>
                <field name="combo_item_id" invisible="1"/>
                <field name="selected_combo_items" invisible="1"/>
                <field name="virtual_id" invisible="1"/>
                <field name="linked_virtual_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//label[@for='product_id']" position="attributes"><attribute name="invisible">1</attribute></xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']/.." position="attributes"><attribute name="invisible">1</attribute></xpath>
            <!-- AC-011/012, VP-02: розміри виробу — функція «конфігуратор» коробки B (group_feature_configurator) -->
            <!-- на телефоні рядок замовлення — повноекранна форма: розміри виробу редагуються тут, ціна перераховується -->
            <xpath expr="//field[@name='order_line']/form//div[@name='ordered_qty']" position="after">
                <field name="td_is_parametric" invisible="1"/>
                <field name="td_width" invisible="not td_is_parametric" groups="td_mebli_base.group_feature_configurator"/>
                <field name="td_height" invisible="not td_is_parametric" groups="td_mebli_base.group_feature_configurator"/>
                <field name="td_depth" invisible="not td_is_parametric" groups="td_mebli_base.group_feature_configurator"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_td_mebli" model="ir.ui.view">
        <field name="name">sale.order.form.td.mebli</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="td_is_parametric" column_invisible="True"/>
                <field name="td_bom_id" column_invisible="True"/>
                <field name="td_width" optional="show" readonly="not td_is_parametric" width="95px" groups="td_mebli_base.group_feature_configurator"/>
                <field name="td_height" optional="show" readonly="not td_is_parametric" width="95px" groups="td_mebli_base.group_feature_configurator"/>
                <field name="td_depth" optional="show" readonly="not td_is_parametric" width="95px" groups="td_mebli_base.group_feature_configurator"/>
                <field name="td_size_factor" optional="hide" readonly="1" groups="td_mebli_base.group_feature_configurator"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <button name="action_td_generate_bom" type="object" icon="fa-cogs" title="Build specification"
                        invisible="not td_is_parametric or state not in ('draft', 'sent')"/>
                <button name="action_td_open_bom" type="object" icon="fa-list-alt" title="Specification"
                        invisible="not td_bom_id"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='margin']" position="attributes">
                <attribute name="widget">monetary</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_td_view_production" type="object" class="oe_stat_button" icon="fa-industry"
                        invisible="td_production_count == 0" groups="sales_team.group_sale_salesman">
                    <field name="td_production_count" widget="statinfo" string="Production"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='order_details']/field[@name='show_update_pricelist']" position="before">
                <field name="td_launch_date" invisible="not td_launch_date" readonly="1"/>
                <field name="td_hours_to_launch" invisible="state != 'sale' or not td_launch_date" readonly="1"/>
            </xpath>
            <!-- AC-019 (D-05): the amounts of the milestones under the payment terms, in a quotation too -->
            <xpath expr="//group[@name='order_details']/field[@name='payment_term_id']" position="after">
                <field name="td_pay_has_milestones" invisible="1"/>
                <field name="td_pay_schedule_html" invisible="not td_pay_has_milestones" readonly="1"/>
            </xpath>
            <!-- AC-017 (D-12): the tab «Cost» — planned materials and operations of every line, margin of the order -->
            <xpath expr="//notebook/page[@name='order_lines']" position="after">
                <page string="Cost of the Order" name="td_cost_plan" groups="td_mebli_base.group_margin_view,td_mebli_base.group_finance,sales_team.group_sale_manager">
                    <field name="td_cost_line_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="product_id"/>
                            <field name="product_uom_qty" string="Quantity"/>
                            <field name="td_planned_material_cost" sum="Total"/>
                            <field name="td_planned_operation_cost" sum="Total"/>
                            <field name="purchase_price" widget="monetary"/>
                            <field name="price_subtotal" sum="Total"/>
                            <field name="margin" widget="monetary" sum="Total"/>
                            <field name="margin_percent" widget="percentage"/>
                        </list>
                    </field>
                    <group name="td_cost_total">
                        <group>
                            <field name="margin" string="Margin of the Order"/>
                            <field name="margin_percent" string="Margin of the Order, %" widget="percentage"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='qty_delivered']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='qty_invoiced']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_td_mebli" model="ir.ui.view">
        <field name="name">sale.order.list.td.mebli</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="activity_ids" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="activity_ids" position="before">
                <field name="td_launch_date" column_invisible="True"/>
                <field name="td_hours_to_launch" optional="show" readonly="1" avg="Average" width="150px" invisible="state != 'sale' or not td_launch_date"/>
            </field>
        </field>
    </record>

    <record id="view_production_tree_td_mebli_sale" model="ir.ui.view">
        <field name="name">mrp.production.list.td.mebli.sale</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="string">Status</attribute>
                <attribute name="width">140px</attribute>
            </field>
            <field name="name" position="attributes">
                <attribute name="string">Number</attribute>
            </field>
            <field name="product_id" position="after">
                <field name="td_partner_id" optional="show"/>
            </field>
            <field name="priority" position="attributes"><attribute name="optional">hide</attribute></field>
            <field name="activity_ids" position="attributes"><attribute name="optional">hide</attribute></field>
            <field name="origin" position="attributes"><attribute name="optional">hide</attribute></field>
            <field name="product_uom_id" position="attributes"><attribute name="optional">hide</attribute></field>
            <field name="date_start" position="attributes"><attribute name="optional">hide</attribute></field>
            <field name="date_deadline" position="attributes"><attribute name="optional">show</attribute></field>
            <field name="date_deadline" position="attributes">
                <attribute name="invisible">state == 'cancel'</attribute>
            </field>
        </field>
    </record>

    <record id="view_production_form_td_mebli_sale" model="ir.ui.view">
        <field name="name">mrp.production.form.td.mebli.sale</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <field name="product_description_variants" position="attributes">
                <attribute name="string">Options</attribute>
                <!-- the options come on separate lines: a Char field would glue them into one row -->
                <attribute name="widget">text</attribute>
            </field>
        </field>
    </record>

    <record id="view_order_kanban_td_mebli" model="ir.ui.view">
        <field name="name">sale.order.kanban.td.mebli</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="td_stage" group_create="false" quick_create="false"
                    class="o_kanban_small_column">
                <field name="currency_id"/>
                <field name="td_delay_days"/>
                <field name="td_image"/>
                <field name="td_launch_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card" t-attf-class="{{ record.td_delay_days.raw_value > 0 ? 'border-start border-4 border-danger bg-danger-subtle' : '' }}">
                        <div class="d-flex gap-2">
                            <field name="td_image" widget="image" options="{'size': [56, 56]}" class="flex-shrink-0 rounded"/>
                            <div class="flex-grow-1 text-truncate">
                                <field name="partner_id" class="fw-bolder"/>
                                <div class="text-muted small"><field name="name"/></div>
                                <div class="text-muted small" t-if="record.date_order.raw_value"><field name="date_order" widget="date"/></div>
                            </div>
                        </div>
                        <div class="d-flex align-items-baseline mt-2">
                            <field name="amount_total" widget="monetary" class="fw-bolder"/>
                            <field name="margin_percent" widget="percentage" class="ms-auto text-success"/>
                        </div>
                        <!-- AC-066: the shift of the forecast and its reason -->
                        <div t-if="record.td_delay_days.raw_value > 0" class="small text-danger fw-bold td_card_delay">
                            <i class="fa fa-exclamation-triangle me-1" title="Shift"/>+<field name="td_delay_days"/> d. ·
                            <field name="td_delay_reason"/>
                        </div>
                        <footer class="align-items-center">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <span class="ms-auto small text-muted" t-if="record.td_launch_date.raw_value"
                                  title="From the order to the start of work"><i class="fa fa-clock-o me-1"/>to launch: <field name="td_hours_to_launch"/> h</span>
                            <span class="ms-auto small text-warning" t-elif="record.state.raw_value == 'sale' and record.td_hours_to_launch.raw_value >= 1"
                                  title="The order is waiting for the start of work"><i class="fa fa-hourglass-half me-1"/>waiting: <field name="td_hours_to_launch"/> h</span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- AC-066: the list of the board — red rows, the shift and its reason; grouped by the reason it gives KPI 2 -->
    <record id="view_order_board_list_td_mebli" model="ir.ui.view">
        <field name="name">sale.order.board.list.td.mebli</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="td_delay_days &gt; 0">
                <field name="name" string="Order"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="td_stage"/>
                <field name="commitment_date" widget="date"/>
                <field name="td_forecast_date"/>
                <field name="td_delay_days" sum="Total"/>
                <field name="td_delay_reason"/>
                <field name="td_stage_date" optional="hide"/>
                <field name="amount_total" widget="monetary" sum="Total" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_order_board_search_td_mebli" model="ir.ui.view">
        <field name="name">sale.order.board.search.td.mebli</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="td_at_risk" string="Date at Risk" domain="[('td_delay_days', '&gt;', 0)]"/>
                <!-- AC-067: days without a move — the parameter of the company (VP-10), read at the time of the search -->
                <filter name="td_stuck" string="Stuck" domain="[('td_is_stuck', '=', True)]"/>
                <separator/>
                <filter name="my" string="My Orders" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_td_delay_reason" string="Shift Reason" context="{'group_by': 'td_delay_reason'}"/>
                    <filter name="group_td_stage" string="Order Stage" context="{'group_by': 'td_stage'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_orders_board_td_mebli" model="ir.actions.act_window">
        <field name="name">Order Board</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', '!=', 'cancel')]</field>
        <field name="search_view_id" ref="view_order_board_search_td_mebli"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_order_kanban_td_mebli')}),
                                      (0, 0, {'view_mode': 'list', 'view_id': ref('view_order_board_list_td_mebli')}),
                                      (0, 0, {'view_mode': 'form'})]"/>
    </record>

    <record id="view_order_launch_list_td_mebli" model="ir.ui.view">
        <field name="name">sale.order.launch.list.td.mebli</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="date_order desc">
                <field name="name" string="Order"/>
                <field name="partner_id"/>
                <field name="date_order" string="Ordered" widget="datetime"/>
                <field name="td_launch_date" string="Work started" widget="datetime"/>
                <field name="td_hours_to_launch" string="Order to launch, h" avg="Average" width="260px"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_orders_launch_td_mebli" model="ir.actions.act_window">
        <field name="name">Time from Order to Launch</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('td_stage', 'in', ('progress', 'done')),
                              ('date_order', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_order_launch_list_td_mebli')}),
                                      (0, 0, {'view_mode': 'form'})]"/>
    </record>

    <menuitem id="menu_orders_launch_td_mebli" name="Time from Order to Launch" parent="sale.menu_sale_report"
              action="action_orders_launch_td_mebli" sequence="25" groups="sales_team.group_sale_salesman"/>

    <menuitem id="menu_orders_board_td_mebli" name="Order Board" parent="sale.sale_order_menu"
              action="action_orders_board_td_mebli" sequence="25" groups="sales_team.group_sale_salesman"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AC-083: the storekeeper sees the purchase lines that come later than needed and the customer orders they touch -->
    <record id="purchase_order_line_td_delayed_list" model="ir.ui.view">
        <field name="name">purchase.order.line.td.delayed.list</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="td_late_days &gt; 0" default_order="date_planned">
                <field name="partner_id" string="Supplier"/>
                <field name="order_id" string="Purchase"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="qty_received" optional="hide"/>
                <field name="date_planned" string="Supplier Date" widget="date"/>
                <field name="td_supplier_delay" optional="show"/>
                <field name="td_need_date"/>
                <field name="td_late_days"/>
                <field name="td_sale_order_ids" widget="many2many_tags"/>
                <button name="action_td_open_sale_orders" type="object" icon="fa-external-link" title="Open the customer order"
                        invisible="not td_sale_order_ids"/>
            </list>
        </field>
    </record>

    <record id="purchase_order_line_td_delayed_action" model="ir.actions.act_window">
        <field name="name">Delayed Deliveries</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('td_is_late', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('purchase_order_line_td_delayed_list')})]"/>
    </record>

    <menuitem id="purchase_order_line_td_delayed_menu_stock" name="Delayed Deliveries"
              parent="stock.menu_stock_warehouse_mgmt" action="purchase_order_line_td_delayed_action" sequence="20"
              groups="stock.group_stock_user"/>
    <menuitem id="purchase_order_line_td_delayed_menu_purchase" name="Delayed Deliveries"
              parent="purchase.menu_procurement_management" action="purchase_order_line_td_delayed_action" sequence="20"
              groups="purchase.group_purchase_user"/>
</odoo>

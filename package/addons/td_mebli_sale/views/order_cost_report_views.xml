<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_line_td_cost_list" model="ir.ui.view">
        <field name="name">sale.order.line.td.cost.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="td_width"/>
                <field name="td_height"/>
                <field name="td_depth"/>
                <field name="product_uom_qty"/>
                <field name="price_subtotal" sum="Total"/>
                <field name="td_planned_material_cost" sum="Total"/>
                <field name="td_planned_operation_cost" sum="Total"/>
                <field name="margin" sum="Total"/>
                <field name="margin_percent" avg="Average" widget="percentage"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="sale_order_line_td_cost_pivot" model="ir.ui.view">
        <field name="name">sale.order.line.td.cost.pivot</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Order Cost">
                <field name="product_id" type="row"/>
                <field name="price_subtotal" type="measure"/>
                <field name="td_planned_material_cost" type="measure"/>
                <field name="td_planned_operation_cost" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sale_order_line_td_cost_search" model="ir.ui.view">
        <field name="name">sale.order.line.td.cost.search</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="product_id"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_order" string="Order" context="{'group_by': 'order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sale_order_line_td_cost_action" model="ir.actions.act_window">
        <field name="name">Order Cost</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('td_is_parametric', '=', True), ('state', '!=', 'cancel')]</field>
        <field name="search_view_id" ref="sale_order_line_td_cost_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('sale_order_line_td_cost_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sale_order_line_td_cost_list')})]"/>
    </record>

    <menuitem id="sale_order_line_td_cost_menu" name="Order Cost" parent="sale.menu_sale_report"
              action="sale_order_line_td_cost_action" sequence="30" groups="sales_team.group_sale_salesman"/>
</odoo>

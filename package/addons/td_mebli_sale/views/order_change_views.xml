<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_mebli_order_change_wizard_form" model="ir.ui.view">
        <field name="name">td.mebli.order.change.wizard.form</field>
        <field name="model">td.mebli.order.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Create a Change">
                <p class="text-muted">The current price and promised date are fixed as «before»; change the lines and the
                    date of the order, then press «Fix the Change».</p>
                <div class="alert alert-warning" role="alert" invisible="not cut_version">
                    The specification has been sent to cutting (version <field name="cut_version" class="oe_inline"/>):
                    only an additional order (a new line of the order, a new manufacturing order) is possible.
                </div>
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="kind" widget="radio" options="{'horizontal': True}" readonly="cut_version"/>
                    <field name="reason" widget="radio" options="{'horizontal': True}"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_order_form_td_mebli_change" model="ir.ui.view">
        <field name="name">sale.order.form.td_mebli_change</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_td_open_change" type="object" string="Create a Change"
                        invisible="state != 'sale' or td_change_open"/>
                <button name="action_td_fix_change" type="object" string="Fix the Change" class="btn-primary"
                        invisible="not td_change_open"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Changes" name="td_changes" invisible="not td_change_ids">
                    <field name="td_change_ids" readonly="1">
                        <list decoration-info="state == 'open'" decoration-success="state == 'signed'">
                            <field name="version"/>
                            <field name="kind" optional="show"/>
                            <field name="reason"/>
                            <field name="note"/>
                            <field name="amount_before"/>
                            <field name="amount_after"/>
                            <field name="amount_delta"/>
                            <field name="date_before"/>
                            <field name="date_after"/>
                            <field name="shift_days"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="state" widget="badge" decoration-info="state == 'open'"
                                   decoration-success="state == 'signed'"/>
                            <field name="td_sign_requested" column_invisible="True"/>
                            <field name="signed_on" optional="show" groups="td_mebli_base.group_feature_change_sign"/>
                            <button name="action_td_send_sign" type="object" string="Send the Change for Signature"
                                    icon="fa-pencil-square-o" groups="td_mebli_base.group_feature_change_sign"
                                    invisible="state != 'done'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- AC-120: the fixed changes of the order in the portal of the order; the customer signs those sent to him -->
    <template id="sale_order_portal_content_td_changes" inherit_id="sale.sale_order_portal_content"
              name="Furniture: changes of the order to sign">
        <xpath expr="//section[@id='details']" position="after">
            <t t-set="td_changes" t-value="sale_order.td_change_ids.filtered(lambda c: c.td_sign_requested and c.state in ('done', 'signed'))"/>
            <section t-if="td_changes" id="td_changes" class="mt-4">
                <h4>Changes of the order</h4>
                <table class="table table-sm">
                    <thead><tr><th>Version</th><th>What changes</th><th class="text-end">Price</th><th>Promised</th><th/></tr></thead>
                    <tbody>
                        <tr t-foreach="td_changes" t-as="change">
                            <td t-out="change.version"/>
                            <td t-out="change.note"/>
                            <td class="text-end"><span t-field="change.amount_after" t-options="{'widget': 'monetary', 'display_currency': change.currency_id}"/></td>
                            <td><span t-field="change.date_after"/></td>
                            <td class="text-end">
                                <span t-if="change.state == 'signed'" class="badge text-bg-success">Signed <span t-field="change.signed_on"/></span>
                                <a t-else="" role="button" class="btn btn-primary btn-sm" data-bs-toggle="modal"
                                   t-attf-data-bs-target="#td_change_sign_{{change.id}}" href="#">Sign</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <t t-foreach="td_changes.filtered(lambda c: c.state == 'done')" t-as="change">
                    <div role="dialog" class="modal fade" t-attf-id="td_change_sign_{{change.id}}">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <header class="modal-header">
                                    <h4 class="modal-title">Sign the change <t t-out="change.version"/></h4>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                                </header>
                                <main class="modal-body">
                                    <p>By signing, you accept the change «<t t-out="change.note"/>»: the price
                                        <b t-field="change.amount_after" t-options="{'widget': 'monetary', 'display_currency': change.currency_id}"/>,
                                        the promised date <b t-field="change.date_after"/>.</p>
                                    <t t-call="portal.signature_form">
                                        <t t-set="call_url" t-value="sale_order.get_portal_url(suffix='/change/%s/sign' % change.id)"/>
                                        <t t-set="default_name" t-value="sale_order.partner_id.name"/>
                                    </t>
                                </main>
                            </div>
                        </div>
                    </div>
                </t>
            </section>
        </xpath>
    </template>
</odoo>

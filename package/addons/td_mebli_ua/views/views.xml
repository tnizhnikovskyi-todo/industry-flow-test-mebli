<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_currency_rate_tree_td_mebli_ua" model="ir.ui.view">
        <field name="name">res.currency.rate.list.td_mebli_ua</field>
        <field name="model">res.currency.rate</field>
        <field name="inherit_id" ref="base.view_currency_rate_tree"/>
        <field name="arch" type="xml">
            <field name="rate" position="after">
                <field name="td_source" optional="show"/>
            </field>
        </field>
    </record>

    <!-- AC-037: box B function «nbu» (VP-02); the method checks the group «Finance» -->
    <record id="action_td_update_prices_by_rate" model="ir.actions.server">
        <field name="name">Update Prices at the Rate</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">action = model.td_action_update_prices_by_rate()</field>
        <field name="group_ids" eval="[(6, 0, [ref('td_mebli_base.group_finance')])]"/>
    </record>
    <!-- D-07 (A-11-7): the menu — the finance only (as the action); the function «nbu» is checked by ir.ui.menu (models/ir_ui_menu.py) -->
    <menuitem id="menu_td_update_prices_by_rate" name="Update Prices at the Rate" parent="sale.sale_order_menu"
              action="action_td_update_prices_by_rate" sequence="90" groups="-td_mebli_base.group_feature_nbu,td_mebli_base.group_finance"/>
</odoo>

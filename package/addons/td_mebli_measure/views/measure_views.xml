<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_mebli_measure_view_form" model="ir.ui.view">
        <field name="name">td.mebli.measure.form</field>
        <field name="model">td.mebli.measure</field>
        <field name="arch" type="xml">
            <form string="Measurement Sheet">
                <header>
                    <button name="action_check" type="object" string="Check against the Design" class="btn-primary"
                            invisible="state == 'checked'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="issue_count == 0">
                        <strong>Does not fit: </strong><field name="issue_text" class="d-inline"/>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="td_can_link" invisible="1"/>
                            <!-- D-03: Odoo 19 evaluates «options» once, without the record (web/views/fields/field.js:
                                 evaluateExpr(value)) — only literals there; the link is switched by two copies of the field -->
                            <field name="lead_id" invisible="not td_can_link"/>
                            <field name="lead_id" invisible="td_can_link" readonly="1" options="{'no_open': True}"/>
                            <field name="order_id" invisible="not td_can_link"/>
                            <field name="order_id" invisible="td_can_link" readonly="1" options="{'no_open': True}"/>
                            <field name="customer"/>
                            <field name="td_address"/>
                            <field name="td_phone" widget="phone"/>
                            <field name="room"/>
                        </group>
                        <group>
                            <field name="measurer_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="floor_slope_mm"/>
                            <field name="wall_angle_deg"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Niches and Sizes" name="niches">
                            <field name="niche_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="width_mm"/>
                                    <field name="height_mm"/>
                                    <field name="depth_mm"/>
                                    <field name="protrusion_mm" optional="show"/>
                                    <field name="order_line_id" optional="show" options="{'no_create': True}"/>
                                </list>
                                <!-- AC-007: on a phone the niches are cards (the standard x2many takes the kanban on a small screen) -->
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <field name="name" class="fw-bold"/>
                                            <div class="small text-muted">
                                                <field name="width_mm"/> × <field name="height_mm"/> × <field name="depth_mm"/> mm
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <form string="Niche">
                                    <group>
                                        <field name="name"/>
                                        <field name="width_mm"/>
                                        <field name="height_mm"/>
                                        <field name="depth_mm"/>
                                        <field name="protrusion_mm"/>
                                        <field name="order_line_id" options="{'no_create': True}"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Appliances of the Customer" name="appliances">
                            <field name="appliance_ids">
                                <list editable="bottom" decoration-danger="not fits">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="niche_id"/>
                                    <field name="width_mm"/>
                                    <field name="height_mm"/>
                                    <field name="depth_mm"/>
                                    <field name="fits" column_invisible="True"/>
                                    <field name="td_check" column_invisible="True"/>
                                    <field name="issue" decoration-muted="td_check == 'unchecked'"/>
                                </list>
                                <kanban>
                                    <field name="fits"/>
                                    <templates>
                                        <t t-name="card">
                                            <field name="name" class="fw-bold"/>
                                            <div class="small text-muted">
                                                <field name="width_mm"/> × <field name="height_mm"/> × <field name="depth_mm"/> mm
                                            </div>
                                            <field name="issue" t-att-class="record.fits.raw_value ? 'small' : 'small text-danger fw-bold'"/>
                                        </t>
                                    </templates>
                                </kanban>
                                <form string="Appliance">
                                    <group>
                                        <field name="name"/>
                                        <field name="niche_id"/>
                                        <field name="width_mm"/>
                                        <field name="height_mm"/>
                                        <field name="depth_mm"/>
                                        <field name="issue"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Utilities and Photos" name="photos">
                            <group>
                                <field name="utilities"/>
                                <field name="photo_ids" widget="many2many_binary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="td_mebli_measure_view_list" model="ir.ui.view">
        <field name="name">td.mebli.measure.list</field>
        <field name="model">td.mebli.measure</field>
        <field name="arch" type="xml">
            <list string="Measurement Sheets" decoration-danger="issue_count &gt; 0">
                <field name="name"/>
                <field name="customer"/>
                <field name="room"/>
                <field name="measurer_id" widget="many2one_avatar_user"/>
                <field name="order_id"/>
                <field name="issue_count"/>
                <field name="state" widget="badge" decoration-success="state == 'checked'"/>
            </list>
        </field>
    </record>

    <record id="td_mebli_measure_view_search" model="ir.ui.view">
        <field name="name">td.mebli.measure.search</field>
        <field name="model">td.mebli.measure</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="order_id"/>
                <field name="measurer_id"/>
                <filter name="my" string="My Measurements" domain="[('measurer_id', '=', uid)]"/>
                <separator/>
                <filter name="to_check" string="To Check" domain="[('state', '=', 'draft')]"/>
            </search>
        </field>
    </record>

    <record id="td_mebli_measure_action" model="ir.actions.act_window">
        <field name="name">Measurement Sheets</field>
        <field name="res_model">td.mebli.measure</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_order_form_td_mebli_measure" model="ir.ui.view">
        <field name="name">sale.order.form.td_mebli_measure</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_td_view_measures" type="object" class="oe_stat_button" icon="fa-arrows-alt"
                        invisible="td_measure_count == 0">
                    <field name="td_measure_count" widget="statinfo" string="Measurements"/>
                </button>
            </div>
            <!-- AC-008: the appliances that do not fit — a banner on the order -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0 td_measure_issue_alert" role="alert" invisible="td_measure_issue_count == 0">
                    <i class="fa fa-exclamation-triangle me-2" title="Does not fit"/>
                    <strong>Does not fit by the measurement: <field name="td_measure_issue_count" class="oe_inline"/></strong>
                </div>
            </xpath>
        </field>
    </record>

    <!-- D-15 (A-11-7): after «Orders» (sequence 30), the start screen of «Sales» stays the standard quotations -->
    <menuitem id="td_mebli_measure_menu" name="Measurement Sheets" parent="sale.sale_order_menu"
              action="td_mebli_measure_action" sequence="30" groups="sales_team.group_sale_salesman"/>

    <!-- AC-006: the measurer has no Sales menu; his own app «Measurements»: his sheets and his visits -->
    <record id="td_mebli_measure_my_action" model="ir.actions.act_window">
        <field name="name">My Measurements</field>
        <field name="res_model">td.mebli.measure</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my': 1}</field>
    </record>
    <record id="td_mebli_measure_my_calendar_action" model="ir.actions.act_window">
        <field name="name">My Calendar</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
    <menuitem id="td_mebli_measure_root_menu" name="Measurements" web_icon="crm,static/description/icon.png"
              groups="group_td_mebli_measurer" sequence="8"/>
    <menuitem id="td_mebli_measure_my_menu" name="My Measurements" parent="td_mebli_measure_root_menu"
              action="td_mebli_measure_my_action" sequence="1"/>
    <menuitem id="td_mebli_measure_my_calendar_menu" name="My Calendar" parent="td_mebli_measure_root_menu"
              action="td_mebli_measure_my_calendar_action" sequence="2"/>

    <!-- AC-005: the smart button «Measurements» of the opportunity -->
    <record id="crm_lead_view_form_td_measure_count" model="ir.ui.view">
        <field name="name">crm.lead.form.td.mebli.measure.count</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_td_view_measures" type="object" class="oe_stat_button" icon="fa-arrows-alt"
                        invisible="td_measure_count == 0">
                    <field name="td_measure_count" widget="statinfo" string="Measurements"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Position 28: the design against the measurement before cutting (rules, no AI) — on the manufacturing order -->
    <record id="mrp_production_form_td_measure_check" model="ir.ui.view">
        <field name="name">mrp.production.form.td.mebli.measure.check</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0 td_measure_alert" role="alert"
                     invisible="not td_measure_problems or state in ('done', 'cancel')">
                    <i class="fa fa-exclamation-triangle me-2" title="Check before cutting"/>
                    <strong>Check the design against the measurement before cutting:</strong>
                    <field name="td_measure_problems" class="d-block mt-1"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Position 9: meetings of the measurer (standard calendar), booked from the opportunity -->
    <record id="td_mebli_measure_calendar_action" model="ir.actions.act_window">
        <field name="name">Measurement Calendar</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('opportunity_id', '!=', False)]</field>
    </record>
    <menuitem id="td_mebli_measure_calendar_menu" name="Measurement Calendar" parent="sale.sale_order_menu"
              action="td_mebli_measure_calendar_action" sequence="4" groups="sales_team.group_sale_salesman"/>
</odoo>

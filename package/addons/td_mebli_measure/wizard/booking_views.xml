<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Position 9: free windows of the measurer, booking of the visit (standard meeting of the opportunity) -->
    <record id="td_mebli_measure_booking_form" model="ir.ui.view">
        <field name="name">td.mebli.measure.booking.form</field>
        <field name="model">td.mebli.measure.booking</field>
        <field name="arch" type="xml">
            <form string="Book a Measurement">
                <p class="text-muted">Free windows: the working hours of the company minus the meetings of the measurer in
                    the calendar. The visit is a standard meeting of the opportunity; the customer gets the invitation and
                    a reminder by e-mail a day before.</p>
                <group>
                    <group>
                        <field name="lead_id" readonly="1"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="measurer_id" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="days"/>
                    </group>
                </group>
                <div class="alert alert-warning td_no_slots" role="alert" invisible="slot_ids">
                    <field name="no_slot_text"/>
                </div>
                <field name="slot_ids" class="td_measure_slots" invisible="not slot_ids">
                    <list create="0" delete="0" editable="bottom">
                        <field name="day" readonly="1"/>
                        <field name="label" readonly="1"/>
                        <field name="start" column_invisible="1"/>
                        <field name="stop" column_invisible="1"/>
                        <button name="action_book" type="object" string="Book" class="btn-primary btn-sm"/>
                    </list>
                </field>
                <footer>
                    <button name="action_refresh" type="object" string="Refresh Windows" class="btn-secondary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="crm_lead_view_form_td_measure_booking" model="ir.ui.view">
        <field name="name">crm.lead.form.td.mebli.measure.booking</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_td_book_measure" type="object" string="Book a Measurement" class="btn-secondary"
                        invisible="type == 'lead' or not active"/>
            </xpath>
        </field>
    </record>
</odoo>

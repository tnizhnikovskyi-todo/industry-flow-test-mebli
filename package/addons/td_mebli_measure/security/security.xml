<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- the measurers of the salon: the booking of a measurement offers the first of them by default (no login rule) -->
    <record id="group_td_mebli_measurer" model="res.groups">
        <field name="name">Measurer (measurement visits)</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">The user goes to the measurement visits: the booking wizard offers his free windows.</field>
    </record>

    <!-- a salesperson with «own documents only» sees the measurements she made or that belong to her order or
         opportunity; «all documents», sales managers and the workshop (read) see all -->
    <record id="td_mebli_measure_rule_own" model="ir.rule">
        <field name="name">Measurement sheet: own measurements</field>
        <field name="model_id" ref="model_td_mebli_measure"/>
        <field name="domain_force">['|', '|', ('measurer_id', '=', user.id), ('order_id.user_id', '=', user.id),
                                    ('lead_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="td_mebli_measure_rule_all" model="ir.rule">
        <field name="name">Measurement sheet: all measurements</field>
        <field name="model_id" ref="model_td_mebli_measure"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record id="td_mebli_measure_rule_company" model="ir.rule">
        <field name="name">Measurement sheet: multi-company</field>
        <field name="model_id" ref="model_td_mebli_measure"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

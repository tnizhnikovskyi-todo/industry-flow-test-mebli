<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="td_support.SupportDialog">
        <Dialog title="title" size="'lg'" contentClass="'td_support_dialog'">
            <div t-on-paste="onPaste">
                <div t-if="state.message" class="alert alert-warning td_support_message" role="alert" t-esc="state.message"/>
                <div class="mb-3">
                    <label class="form-label fw-bold" for="td_support_subject">Subject</label>
                    <input id="td_support_subject" class="form-control td_support_subject" t-model="state.subject"
                           placeholder="What happened?" maxlength="200"/>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" for="td_support_description">Description</label>
                    <textarea id="td_support_description" class="form-control td_support_description" rows="4"
                              t-model="state.description"
                              placeholder="What did you do, what did you expect, what happened instead?"/>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Attachments and screenshots</label>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <label class="btn btn-secondary btn-sm mb-0">
                            <i class="fa fa-paperclip me-1"/>Attach a file
                            <input type="file" multiple="multiple" class="d-none td_support_file" t-on-change="onFileChange"/>
                        </label>
                        <span class="text-muted small">or paste a screenshot with Ctrl+V</span>
                    </div>
                    <ul t-if="state.files.length" class="list-unstyled mt-2 mb-0 td_support_files">
                        <li t-foreach="state.files" t-as="file" t-key="file_index" class="d-flex align-items-center gap-2">
                            <i class="fa fa-file-o"/>
                            <span t-esc="file.name"/>
                            <span class="text-muted small" t-esc="'(' + (file.size / 1024).toFixed(0) + ' KB)'"/>
                            <button class="btn btn-link btn-sm text-danger p-0" title="Remove" t-on-click="() => this.removeFile(file_index)">
                                <i class="fa fa-times"/>
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" for="td_support_contact">Contact for the answer</label>
                    <input id="td_support_contact" class="form-control td_support_contact" t-model="state.contact"
                           placeholder="Email or phone"/>
                </div>
                <div class="border rounded p-2 mb-3 bg-light td_support_preview">
                    <button class="btn btn-link p-0 fw-bold text-decoration-none" t-on-click="() => { state.showDetails = !state.showDetails }">
                        <i t-att-class="state.showDetails ? 'fa fa-caret-down me-1' : 'fa fa-caret-right me-1'"/>What will be sent
                    </button>
                    <div t-if="state.showDetails" class="mt-2 small">
                        <table class="table table-sm mb-2">
                            <tbody>
                                <tr><td class="text-muted">To</td><td t-esc="state.context.email_to or '—'"/></tr>
                                <tr><td class="text-muted">Login</td><td t-esc="state.context.login"/></tr>
                                <tr><td class="text-muted">Page</td><td class="text-break" t-esc="pageUrl"/></tr>
                                <tr><td class="text-muted">Odoo version</td><td t-esc="state.context.odoo_version"/></tr>
                                <tr><td class="text-muted">Database identifier</td><td t-esc="state.context.db_uuid"/></tr>
                                <tr><td class="text-muted">ToDo modules</td><td class="text-prewrap" t-esc="state.context.td_modules or '—'"/></tr>
                                <tr t-if="state.files.length"><td class="text-muted">Files</td><td t-esc="state.files.length + ' (' + totalMb + ' MB)'"/></tr>
                            </tbody>
                        </table>
                        <div t-if="trace">
                            <div class="text-muted mb-1">Technical details of the error (passwords, tokens and cookies are removed before sending)</div>
                            <pre class="td_support_trace bg-white border rounded p-2 mb-0" t-esc="trace"/>
                        </div>
                    </div>
                </div>
                <div class="form-check">
                    <input id="td_support_consent" type="checkbox" class="form-check-input td_support_consent" t-model="state.consent"/>
                    <label class="form-check-label" for="td_support_consent">
                        I agree to send this request and the technical data above to the ToDo support
                    </label>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary td_support_send" t-att-disabled="!canSend" t-on-click="send">
                    <i t-if="state.sending" class="fa fa-spinner fa-spin me-1"/>Send
                </button>
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
                <button class="btn btn-link ms-auto td_support_history" t-on-click="openHistory">My requests</button>
            </t>
        </Dialog>
    </t>
</templates>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_td_mebli_director" model="res.groups">
        <field name="name">Factory Director (dashboard)</field>
        <field name="comment">Sees the one-screen dashboard of the factory: revenue, margin, cost. Granted to the owner and the finance manager.</field>
        <!-- security.md §1: the director reads finance (cost AC-115, pay mark AC-021), all sale documents, production
             and the installation project — so every card of the dashboard opens its records (AC-121) -->
        <field name="implied_ids" eval="[(4, ref('td_mebli_base.group_finance')),
                                         (4, ref('sales_team.group_sale_salesman_all_leads')),
                                         (4, ref('mrp.group_mrp_user')),
                                         (4, ref('project.group_project_user')),
                                         (4, ref('stock.group_stock_user'))]"/>
    </record>
</odoo>

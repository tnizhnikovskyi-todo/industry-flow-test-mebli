<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Position 19: price list of a supplier from Excel into the standard vendor pricelist -->
    <record id="td_mebli_price_import_form" model="ir.ui.view">
        <field name="name">td.mebli.price.import.form</field>
        <field name="model">td.mebli.price.import</field>
        <field name="arch" type="xml">
            <form string="Import of a Supplier Price List">
                <p class="text-muted">The price list of the supplier (Excel .xlsx or CSV): the columns are recognized by their
                    titles (code, product, price, minimal quantity, lead time). The prices go into the standard vendor
                    pricelist of the products (Purchase › Products › Vendor Pricelists); nothing else is kept.</p>
                <group>
                    <group>
                        <field name="partner_id" readonly="mapping"/>
                        <field name="file" filename="filename" readonly="mapping"/>
                        <field name="filename" invisible="1"/>
                        <field name="date_start"/>
                    </group>
                    <group invisible="not mapping">
                        <field name="mapping"/>
                        <field name="change_count"/>
                        <field name="unknown_count" decoration-danger="unknown_count > 0"/>
                    </group>
                </group>
                <field name="line_ids" invisible="not mapping">
                    <list decoration-danger="status == 'unknown'" decoration-success="status == 'new'"
                          decoration-warning="status == 'update' and price > old_price" create="0" delete="0">
                        <field name="code"/>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="min_qty"/>
                        <field name="old_price"/>
                        <field name="price"/>
                        <field name="delay"/>
                        <field name="status"/>
                    </list>
                </field>
                <footer>
                    <button name="action_recognize" type="object" string="Recognize Columns" class="btn-primary"
                            invisible="mapping"/>
                    <button name="action_import" type="object" string="Write Prices" class="btn-primary" invisible="not mapping"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="td_mebli_price_import_action" model="ir.actions.act_window">
        <field name="name">Import of a Supplier Price List</field>
        <field name="res_model">td.mebli.price.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>

    <menuitem id="td_mebli_price_import_menu" name="Import of a Price List" parent="purchase.menu_purchase_products"
              action="td_mebli_price_import_action" sequence="30" groups="purchase.group_purchase_user"/>
</odoo>

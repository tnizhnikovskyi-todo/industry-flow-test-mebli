<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_line_td_price_list" model="ir.ui.view">
        <field name="name">purchase.order.line.td.price.list</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Supplier Prices against History" create="0" decoration-danger="td_over_history">
                <field name="date_order" string="Order Date"/>
                <field name="order_id"/>
                <field name="partner_id" string="Vendor"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="price_unit"/>
                <field name="td_history_price"/>
                <field name="td_price_delta_pct"/>
                <field name="td_overpay" sum="Total"/>
                <field name="td_over_history" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="purchase_order_line_td_price_search" model="ir.ui.view">
        <field name="name">purchase.order.line.td.price.search</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter name="over" string="Above History" domain="[('td_over_history', '=', True)]"/>
                <separator/>
                <filter name="confirmed" string="Confirmed" domain="[('state', 'in', ('purchase', 'done'))]"/>
                <group>
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="purchase_order_line_td_price_action" model="ir.actions.act_window">
        <field name="name">Supplier Prices against History</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="purchase_order_line_td_price_list"/>
        <field name="search_view_id" ref="purchase_order_line_td_price_search"/>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="domain">[('display_type', '=', False)]</field>
    </record>

    <menuitem id="purchase_order_line_td_price_menu" name="Prices against History" parent="purchase.purchase_report_main"
              action="purchase_order_line_td_price_action" sequence="20"/>
</odoo>

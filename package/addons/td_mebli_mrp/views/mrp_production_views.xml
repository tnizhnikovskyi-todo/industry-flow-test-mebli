<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- до запуску колонка показує зарезервоване (цілі листи й обрізки), а не спожите: підпис це відображає -->
    <record id="mrp_production_form_td_mebli" model="ir.ui.view">
        <field name="name">mrp.production.form.td.mebli</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='quantity']" position="attributes">
                <attribute name="string">Reserved / consumed</attribute>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_td_mebli" model="ir.ui.view">
        <field name="name">product.template.form.td.mebli</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Furniture Parts" name="td_mebli_parts">
                    <group>
                        <group string="Parametric product">
                            <field name="td_is_parametric"/>
                            <field name="td_edge_allowance_mm" invisible="not td_is_parametric"/>
                        </group>
                        <group string="Material" name="td_material">
                            <field name="td_material_kind"/>
                            <field name="td_sheet_length_mm" invisible="td_material_kind != 'board'"/>
                            <field name="td_sheet_width_mm" invisible="td_material_kind != 'board'"/>
                            <field name="td_thickness_mm" invisible="td_material_kind not in ('board', 'edge')"/>
                            <field name="td_waste_pct" invisible="td_material_kind != 'board'"/>
                            <field name="td_matches_board_id" invisible="td_material_kind != 'edge'"/>
                            <field name="td_edge_thickness" invisible="td_material_kind != 'edge'"/>
                        </group>
                    </group>
                    <group string="Dimensions, mm" invisible="not td_is_parametric">
                        <group>
                            <field name="td_width_nominal"/>
                            <field name="td_height_nominal"/>
                            <field name="td_depth_nominal"/>
                        </group>
                        <group>
                            <label for="td_width_min" string="Width min / max"/>
                            <div class="d-flex gap-2"><field name="td_width_min"/><field name="td_width_max"/></div>
                            <label for="td_height_min" string="Height min / max"/>
                            <div class="d-flex gap-2"><field name="td_height_min"/><field name="td_height_max"/></div>
                            <label for="td_depth_min" string="Depth min / max"/>
                            <div class="d-flex gap-2"><field name="td_depth_min"/><field name="td_depth_max"/></div>
                        </group>
                    </group>
                    <field name="td_part_rule_ids" invisible="not td_is_parametric" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="qty"/>
                            <field name="material_role"/>
                            <field name="fixed_material_id" invisible="material_role != 'fixed'"/>
                            <field name="len_w" optional="show"/>
                            <field name="len_h" optional="show"/>
                            <field name="len_d" optional="show"/>
                            <field name="len_const" optional="show"/>
                            <field name="wid_w" optional="show"/>
                            <field name="wid_h" optional="show"/>
                            <field name="wid_d" optional="show"/>
                            <field name="wid_const" optional="show"/>
                            <field name="edge_long_sides"/>
                            <field name="edge_short_sides"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_attribute_form_td_mebli" model="ir.ui.view">
        <field name="name">product.attribute.form.td.mebli</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="arch" type="xml">
            <field name="create_variant" position="after">
                <field name="td_dimension"/>
                <field name="td_component_role"/>
            </field>
            <xpath expr="//field[@name='value_ids']//field[@name='default_extra_price']" position="after">
                <field name="td_component_product_id" column_invisible="not parent.td_component_role"/>
                <field name="td_edge_thickness" column_invisible="parent.td_component_role != 'edge'"/>
            </xpath>
        </field>
    </record>
</odoo>
